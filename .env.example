# Copie este archivo como ".env" y complete los valores (o use iniciar-docker.bat / instalar.sh, que lo hacen solos).
# NUNCA suba ".env" a GitHub.

# Base de datos
DB_PASSWORD=cambie-esta-clave-larga

# Seguridad: genere uno con:  openssl rand -hex 48
JWT_SECRET=

# Usuario de Dirección (Sandra). Se crea una sola vez, la primera vez que inicia el sistema.
ADMIN_USER=sandra
ADMIN_PASSWORD=

# Usuario de profesional predeterminado, SIN permisos de administración (debe cambiar su clave al primer ingreso).
PROFESIONAL_USER=profesional
PROFESIONAL_PASSWORD=

# Acceso: 127.0.0.1 = solo este computador. 0.0.0.0 = también otros equipos de la red del centro.
BIND=127.0.0.1
PUERTO=3000

# Poner en true SOLO cuando el sistema se sirva por HTTPS (con http:// el inicio de sesión no funcionaría).
COOKIE_SECURE=false
# Dominio para HTTPS automático con Caddy (perfil "https")
DOMINIO=

# Datos ficticios de demostración (déjelo en false en el uso real)
SEED_DEMO=false

# Correo saliente (opcional aquí: lo normal es configurarlo después en Administración → Configuración y correo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Deva Aesthetic House <no-responder@su-dominio.cl>"
